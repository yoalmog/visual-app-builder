# Visual App Builder — Environment Variables
# Copy this file to .env.local and fill in your API key

# ─── Google Gemini AI (required for real AI generation) ───────────────────────
# Get your API key at: https://aistudio.google.com/apikey
NEXT_PUBLIC_GEMINI_API_KEY=

# Optional: Override the default model (gemini-2.0-flash-exp is recommended)
# NEXT_PUBLIC_GEMINI_MODEL=gemini-2.0-flash-exp

{
  "name": "visual-app-builder",
  "version": "1.0.0",
  "description": "Enterprise Visual Application Builder Platform with AI Generation & Agent Builder",
  "author": "yoalmog",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/copy-standalone-assets.js",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "tsx scripts/run-all-acceptance-tests.ts",
    "test:phase3": "tsx scripts/run-phase3-suite.ts",
    "test:phase9": "tsx scripts/run-phase9-suite.ts",
    "test:phase10": "tsx scripts/run-phase10-suite.ts && tsx scripts/run-phase10-failure-injection.ts",
    "test:phase11": "tsx scripts/run-phase11-suite.ts && tsx scripts/run-phase11-chaos.ts",
    "test:phase11:load": "tsx scripts/run-phase11-loadtest.ts",
    "electron": "electron .",
    "build:windows": "npm run build && electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.antigravity.visualappbuilder",
    "productName": "Visual App Builder",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.5.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  }
}
